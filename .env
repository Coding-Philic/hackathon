# Database Configuration (for Docker)
DATABASE_URL=postgresql://postgres:password@postgres:5432/mediops
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# LLM Provider — set to 'openai', 'gemini', or 'mock'
# 'mock' uses rule-based fallback (no API key needed, safe for demos)
LLM_PROVIDER=mock

# OpenAI — set LLM_PROVIDER=openai and fill in your key
OPENAI_API_KEY=

# Google Gemini — set LLM_PROVIDER=gemini and fill in your key
GEMINI_API_KEY=
