# Database Configuration (for Docker)
DATABASE_URL=postgresql://postgres:password@postgres:5432/mediops
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# LLM Providers (Leave empty to use high-fidelity Local Rule-Based Mock Agent)
# Supported options: openai, gemini, mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Development Settings (uncomment when running outside docker)
# DATABASE_URL=sqlite:///./mediops.db
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0
